{
  "name": "@ricenote/server",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "RiceNote HTTP 服务与 CLI 入口",
  "main": "./dist/index.js",
  "bin": {
    "ricenote": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/cli/index.ts migrate",
    "validate": "tsx src/cli/index.ts validate",
    "setup": "tsx src/cli/index.ts setup",
    "plugin": "tsx src/cli/index.ts plugin",
    "theme": "tsx src/cli/index.ts theme"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@ricenote/core": "workspace:*",
    "@ricenote/plugin-sdk": "workspace:*",
    "@ricenote/shared": "workspace:*",
    "@ricenote/theme-sdk": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
