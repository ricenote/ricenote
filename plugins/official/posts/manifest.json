{
  "schemaVersion": 1,
  "id": "rice.posts",
  "name": "文章",
  "description": "提供文章撰写、发布、归档与前台页面（首页、文章页、分类/标签归档、搜索）。",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "author": "RiceNote",
  "license": "MIT",
  "entry": "./dist/index.js",
  "requires": {
    "identity.users@1": "^1.0.0"
  },
  "provides": ["content.posts@1"],
  "capabilities": [
    "database:own",
    "services:provide",
    "services:consume",
    "routes:public",
    "routes:admin",
    "events:publish",
    "events:subscribe",
    "slots:register",
    "admin:menu"
  ],
  "migrations": "./migrations",
  "settings": {
    "pageSize": 10,
    "excerptLength": 160
  }
}
