{
  "schemaVersion": 1,
  "id": "rice.identity",
  "name": "身份与认证",
  "description": "提供用户账号、会话与登录取证能力；角色与权限由 authorization 插件负责。",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "author": "RiceNote",
  "license": "MIT",
  "entry": "./dist/index.js",
  "provides": ["identity.auth@1", "identity.users@1"],
  "capabilities": [
    "database:own",
    "services:provide",
    "services:consume",
    "routes:admin",
    "events:publish",
    "events:subscribe",
    "admin:menu"
  ],
  "migrations": "./migrations",
  "settings": {
    "sessionTtlSeconds": 7200,
    "maxSessionsPerUser": 10
  }
}
