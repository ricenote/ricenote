{
  "schemaVersion": 1,
  "id": "rice.taxonomy",
  "name": "分类与标签",
  "description": "为文章提供分类与标签，方便组织与归档内容。",
  "version": "1.1.0",
  "apiVersion": "^1.0.0",
  "author": "RiceNote",
  "license": "MIT",
  "entry": "./dist/index.js",
  "provides": ["content.taxonomy@1"],
  "capabilities": [
    "database:own",
