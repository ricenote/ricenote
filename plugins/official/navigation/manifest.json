{
  "schemaVersion": 1,
  "id": "rice.navigation",
  "name": "导航栏",
  "description": "顶部导航栏的唯一来源：把「自定义链接 / 页面 / 文章」编排成有序导航项，通过 header.navigation 插槽输出到前台，并在后台提供独立管理页。",
  "version": "1.1.0",
  "apiVersion": "^1.0.0",
  "author": "RiceNote",
  "license": "MIT",
  "entry": "./dist/index.js",
  "provides": ["content.navigation@1"],
  "capabilities": [
    "database:own",
    "services:provide",
    "services:consume",
    "routes:admin",
    "events:subscribe",
    "slots:register"
  ],
  "migrations": "./migrations",
  "admin": {
    "pages": [
      {
        "id": "navigation.items",
        "label": "导航栏",
        "path": "/navigation",
        "icon": "Navigation",
        "order": 18,
        "permission": "nav.view",
        "entry": "./admin/main.js"
      }
    ]
  },
  "settingsSchema": {
    "general": {
      "label": { "zh-CN": "通用", "en": "General" },
      "description": {
        "zh-CN": "影响前台导航栏的渲染。修改后需重启服务生效。",
        "en": "Affects how the navigation bar is rendered. A restart is required after changes."
      },
      "fields": {
        "maxItems": {
          "type": "number",
          "label": { "zh-CN": "导航最多展示项数", "en": "Max navigation items" },
          "description": {
            "zh-CN": "超出部分不渲染（按后台顺序取前 N 项），用于避免导航被塞爆",
            "en": "Items beyond this number are not rendered (the first N in admin order)"
          },
          "default": 10,
          "min": 1,
          "max": 50
        }
      }
    }
  }
}
