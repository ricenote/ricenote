  "version": "1.2.0",
  "apiVersion": "^1.0.0",
  "author": "RiceNote",
  "license": "MIT",
  "entry": "./dist/index.js",
  "requires": {
    "identity.users@1": "^1.0.0"
  },
  "provides": ["identity.authorization@1"],
  "capabilities": [
    "database:own",
