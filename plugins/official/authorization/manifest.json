{
  "schemaVersion": 1,
  "id": "rice.authorization",
  "name": "角色与权限",
  "description": "实现角色、权限点与用户-角色分派；Core 的安全网关据此执行 fail-closed 鉴权。",
  "version": "1.3.0",
  "apiVersion": "^1.0.0",
  "author": "RiceNote",
  "license": "MIT",
  "entry": "./dist/index.js",
  "requires": {
    "identity.users@1": "^1.0.0"
  },
  "provides": ["identity.authorization@1"],
  "capabilities": [
    "database:own",
    "services:provide",
    "services:consume",
    "events:subscribe",
    "events:publish",
    "routes:admin"
  ],
  "migrations": "./migrations",
  "admin": {
    "pages": [
      {
        "id": "users.roles",
        "label": "角色与权限",
        "path": "/roles",
        "icon": "ShieldCheck",
        "order": 20,
        "permission": "user.manage",
        "entry": "./admin/main.js"
      }
    ]
  }
}
