{
  "name": "@ricenote/theme-sdk",
  "version": "0.6.2",
  "type": "module",
  "description": "RiceNote 主题 SDK：模板上下文类型、helper/filter 契约与 theme.json 校验器",
  "homepage": "https://github.com/ricenote/theme-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricenote/theme-sdk.git"
  },
  "license": "MIT",
  "author": "RiceNote",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shortcodes/tokenizer": {
      "types": "./dist/shortcodes/tokenizer.d.ts",
      "import": "./dist/shortcodes/tokenizer.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:browser": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@ricenote/shared": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
