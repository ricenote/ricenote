{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ricenote.dev/schemas/theme.schema.json",
  "title": "RiceNote Theme Manifest",
  "description": "RiceNote 主题清单（theme.json）契约 v1。",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "apiVersion", "engine", "templates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 80,
      "description": "主题唯一标识，形如 rice.minimal。"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "type": "string", "minLength": 1 },
    "engine": { "const": "nunjucks" },
    "author": { "type": "string", "maxLength": 160 },
    "license": { "type": "string", "maxLength": 64 },
    "screenshot": {
      "type": "string",
      "pattern": "^\\./",
      "description": "主题预览图相对路径，例如 ./screenshot.png。"
    },
    "templates": {
      "type": "object",
      "description": "页面类型到模板文件的映射。自定义页面使用的页面类型为 `page`（例如 \"page\": \"page.njk\"）。",
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\]+\\.njk$"
      }
    },
    "pageTemplates": {
      "type": "object",
      "description": "可供「页面」与「文章」选择的模板清单：键为模板选项键（内容中的 template 字段存该值），值为模板文件与展示文案。未声明时内容回退到其 kind 模板。",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["template", "label"],
        "additionalProperties": false,
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+\\.njk$"
          },
          "label": { "$ref": "https://ricenote.dev/schemas/settings.schema.json#/definitions/localizedText" },
          "description": { "$ref": "https://ricenote.dev/schemas/settings.schema.json#/definitions/localizedText" }
        }
      }
    },
    "requires": {
      "type": "object",
      "description": "主题依赖的插件能力契约，缺失时给出降级提示。",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "settings": {
      "$ref": "https://ricenote.dev/schemas/settings.schema.json#/definitions/settingsSchema"
    },
    "contentFields": {
      "type": "object",
      "description": "内容自定义字段：文章与页面共用同一份声明（例如 featuredImage 特色图片）。键为字段名，值为字段定义；字段类型与设置表单完全一致，后台据此生成控件。",
      "maxProperties": 20,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
      "additionalProperties": {
        "$ref": "https://ricenote.dev/schemas/settings.schema.json#/definitions/settingField"
      }
    }
  }
}
