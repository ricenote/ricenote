{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ricenote.dev/schemas/plugin.schema.json",
  "title": "RiceNote Plugin Manifest",
  "description": "RiceNote 插件清单（manifest.json）契约 v1。",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "apiVersion", "entry"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Manifest 结构版本，v1 固定为 1。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 80,
      "description": "插件唯一标识，形如 rice.posts。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "插件显示名称。"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "description": "插件版本，遵循语义化版本。"
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "description": "所依赖的 RiceNote Plugin API 区间，例如 ^1.0.0。"
    },
    "author": { "type": "string", "maxLength": 160 },
    "license": { "type": "string", "maxLength": 64 },
    "homepage": { "type": "string", "maxLength": 300 },
    "entry": {
      "type": "string",
      "pattern": "^\\./",
      "description": "相对于插件目录的入口模块路径，例如 ./dist/index.js。"
    },
    "requires": {
      "type": "object",
      "description": "依赖声明：键为 capability 契约或插件 ID，值为 semver 区间。",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:@\\d+)?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provides": {
      "type": "array",
      "description": "对外提供的能力契约，例如 [\"content.posts@1\"]。",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*@\\d+$"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "description": "请求的内核能力白名单。",
      "items": {
        "enum": [
          "routes:public",
          "routes:admin",
          "database:own",
          "events:publish",
          "events:subscribe",
          "services:provide",
          "services:consume",
          "slots:register",
          "admin:menu",
          "media:store",
          "extensions:declare",
          "extensions:contribute"
        ]
      },
      "uniqueItems": true
    },
    "migrations": {
      "type": "string",
      "pattern": "^\\./",
      "description": "相对于插件目录的迁移目录，例如 ./migrations。"
    },
    "settings": {
      "type": "object",
      "description": "插件自有配置声明的默认值（键为配置路径）。向后兼容的旧写法：未声明 settingsSchema 时 config.get 直接读取这里的值。",
      "additionalProperties": true
    },
    "settingsSchema": {
      "description": "插件设置的声明式表单定义（分组 + 字段），结构与主题设置完全一致。声明后后台自动生成设置表单，且未声明的字段会被拒绝写入。",
      "allOf": [
        { "$ref": "https://ricenote.dev/schemas/settings.schema.json#/definitions/settingsSchema" }
      ]
    },
    "extensionPoints": {
      "type": "array",
      "maxItems": 30,
      "description": "本插件对外暴露的命名扩展点：别的插件据此向它的界面或流程接入（声明只描述契约，挂载点由插件自己的界面决定）。",
      "items": {
        "type": "object",
        "required": ["name", "scope"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)+$",
            "maxLength": 160,
            "description": "扩展点名，形如 rice.posts.list.actions。"
          },
          "scope": {
            "enum": ["admin", "render", "server"],
            "description": "admin 后台界面 / render 站点渲染 / server 服务端钩子。"
          },
          "replaceable": {
            "type": "boolean",
            "description": "是否允许 replace 贡献接管（缺省 true）。"
          },
          "description": { "type": "string", "maxLength": 300 },
          "props": {
            "type": "array",
            "maxItems": 20,
            "description": "契约文档：贡献者会收到哪些字段（admin 为组件 props 名）。",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "maxLength": 60 },
                "description": { "type": "string", "maxLength": 200 }
              }
            }
          }
        }
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 40,
      "description": "声明式贡献：向扩展点贡献内容（admin 为浏览器模块、render 为 Slot 组件、server 为钩子模块）。随插件启停自动生效。",
      "items": {
        "type": "object",
        "required": ["point", "scope", "entry"],
        "additionalProperties": false,
        "properties": {
          "point": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)+$",
            "maxLength": 160
          },
          "scope": { "enum": ["admin", "render", "server"] },
          "mode": {
            "enum": ["append", "replace"],
            "description": "replace 时默认内容与其他追加贡献都不再呈现（胜出者取 order 最大者）。"
          },
          "order": { "type": "number" },
          "entry": {
            "type": "string",
            "pattern": "^\\./(admin|dist)/[A-Za-z0-9._/-]+\\.js$",
            "description": "入口模块：admin 限 ./admin/*.js（浏览器 import）；render/server 限 ./dist/*.js（Node import）。"
          },
          "style": {
            "type": "string",
            "pattern": "^\\./admin/[A-Za-z0-9._/-]+\\.css$",
            "description": "仅 admin：随贡献加载的样式文件。"
          },
          "permission": {
            "type": "string",
            "maxLength": 80,
            "description": "仅 admin：按当前用户权限过滤（不满足则不下发）。"
          },
          "label": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "admin": {
      "type": "object",
      "description": "插件自带后台界面的声明：界面代码放在插件目录的 ./admin/ 下，Core 负责托管并把每页注册为后台菜单入口。",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "label", "path", "entry"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{1,80}$",
                "description": "菜单项 ID，全局唯一，例如 posts.list。"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "path": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
                "maxLength": 180,
                "description": "后台前端路由路径，必须以 / 开头且全局唯一（例如 /posts）。"
              },
              "icon": {
                "type": "string",
                "maxLength": 60,
                "description": "图标名（见后台界面 SDK 的受控图标集）。"
              },
              "order": { "type": "number" },
              "permission": {
                "type": "string",
                "maxLength": 80,
                "description": "访问该页面所需权限点；为空表示仅需登录。"
              },
              "entry": {
                "type": "string",
                "pattern": "^\\./admin/[A-Za-z0-9._/-]+\\.js$",
                "description": "相对插件目录的界面入口模块（零构建 ESM），例如 ./admin/main.js。"
              },
              "style": {
                "type": "string",
                "pattern": "^\\./admin/[A-Za-z0-9._/-]+\\.css$",
                "description": "可选：插件自带样式（相对插件目录），声明后由宿主动态注入；不声明则不加载。"
              },
              "hidden": {
                "type": "boolean",
                "description": "为 true 时只注册路由、不出现在侧栏。用于由列表页跳转进入的页面（如独立编辑页）：深链与刷新仍然可用。"
              }
            }
          }
        }
      }
    }
  }
}
