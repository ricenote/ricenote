{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ricenote.dev/schemas/settings.schema.json",
  "title": "RiceNote Settings Schema",
  "description": "主题设置（theme.json 的 settings）与插件设置（manifest.json 的 settingsSchema）共用的声明定义。两侧结构完全一致，因此后台可以复用同一套表单渲染与校验实现。",
  "definitions": {
    "localizedText": {
      "description": "可本地化的展示文案：字符串，或「语言标签 → 文案」的映射（如 { \"zh-CN\": \"主色\", \"en\": \"Accent\" }）。运行时按站点语言解析。",
      "oneOf": [
        { "type": "string", "maxLength": 300 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8})*$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      ]
    },
    "settingField": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["text", "textarea", "color", "boolean", "number", "select", "image", "url", "stringList"]
        },
        "label": { "$ref": "#/definitions/localizedText" },
        "description": { "$ref": "#/definitions/localizedText" },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "description": "stringList 专用：列表最多允许多少项（默认 200）。"
        },
        "placeholder": { "$ref": "#/definitions/localizedText" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/definitions/localizedText" },
              "value": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "number" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "color" } }, "required": ["type"] },
          "then": {
            "properties": {
              "default": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "stringList" } }, "required": ["type"] },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "maxItems": 200,
                "items": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      ]
    },
    "settingGroup": {
      "type": "object",
      "required": ["label", "fields"],
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/definitions/localizedText" },
        "description": { "$ref": "#/definitions/localizedText" },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/settingField" }
        }
      }
    },
    "settingsSchema": {
      "type": "object",
      "description": "设置分组：键为分组键，值为 { label, description?, fields }。",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
      "additionalProperties": { "$ref": "#/definitions/settingGroup" }
    }
  }
}
