{
  "name": "@ricenote/shared",
  "version": "0.8.0",
  "type": "module",
  "description": "RiceNote 公共契约：DTO、错误码、capability 工具与 Manifest JSON Schema",
  "homepage": "https://github.com/ricenote/ricenote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricenote/ricenote.git"
  },
  "license": "MIT",
  "author": "RiceNote",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shortcodes": {
      "types": "./dist/shortcodes.d.ts",
      "import": "./dist/shortcodes.js"
    },
    "./manifests/plugin.schema.json": "./manifests/plugin.schema.json",
    "./manifests/theme.schema.json": "./manifests/theme.schema.json",
    "./manifests/settings.schema.json": "./manifests/settings.schema.json",
    "./manifests/plugin-catalog.json": "./manifests/plugin-catalog.json",
    "./manifests/plugin-catalog.schema.json": "./manifests/plugin-catalog.schema.json"
  },
  "files": [
    "dist",
    "manifests"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/semver": "^7.5.8"
  }
}
