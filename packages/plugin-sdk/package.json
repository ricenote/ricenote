{
  "name": "@ricenote/plugin-sdk",
  "version": "0.6.2",
  "type": "module",
  "description": "RiceNote 插件 SDK：稳定公共接口（PluginContext / Plugin / 路由与服务契约）",
  "homepage": "https://github.com/ricenote/plugin-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricenote/plugin-sdk.git"
  },
  "license": "MIT",
  "author": "RiceNote",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ricenote/shared": "workspace:^"
  }
}
