{
  "name": "@ricenote/core",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "RiceNote 内核：插件/主题管理、服务与事件、路由、渲染、数据库适配与安全网关",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ricenote/plugin-sdk": "workspace:*",
    "@ricenote/shared": "workspace:*",
    "@ricenote/theme-sdk": "workspace:*",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "mysql2": "^3.12.0",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.14.0",
    "semver": "^7.6.3",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.13.0",
    "@types/semver": "^7.5.8",
    "@types/tar": "^7.0.87"
  }
}
