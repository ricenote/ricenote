{
  "name": "@ricenote/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RiceNote 单元与集成测试",
  "scripts": {
    "test": "node --import tsx --test unit/*.test.ts integration/*.test.ts",
    "test:unit": "node --import tsx --test unit/*.test.ts",
