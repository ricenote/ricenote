    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ricenote/core": "workspace:*",
    "@ricenote/plugin-sdk": "workspace:*",
    "@ricenote/server": "workspace:*",
    "@ricenote/shared": "workspace:*",
    "@ricenote/theme-sdk": "workspace:*",
    "adm-zip": "^0.5.16",
    "mysql2": "^3.12.0"
  }
}
