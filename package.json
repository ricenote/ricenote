{
  "name": "ricenote",
  "version": "0.6.2",
  "private": true,
  "description": "RiceNote - 插件优先的模块化博客与内容管理系统",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs --sync",
    "version:bump": "node scripts/version.mjs --bump",
    "build": "pnpm version:check && pnpm -r --filter \"./packages/**\" --filter \"./plugins/official/**\" --filter \"./plugins/third-party/**\" --filter \"./apps/server\" --filter \"./apps/admin\" build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ricenote/tests test",
    "dev": "pnpm --filter @ricenote/server dev",
    "dev:admin": "pnpm --filter @ricenote/admin dev",
    "start": "pnpm --filter @ricenote/server start",
    "migrate": "pnpm --filter @ricenote/server migrate",
    "validate": "pnpm version:check && pnpm --filter @ricenote/server validate",
    "plugin": "pnpm --filter @ricenote/server plugin",
    "theme": "pnpm --filter @ricenote/server theme",
    "setup": "pnpm --filter @ricenote/server run setup",
    "release:plugins": "pnpm version:check && node scripts/release-plugins.mjs",
    "repos:plugins": "node scripts/split-plugin-repos.mjs",
    "wiki:check": "pnpm version:check && node scripts/publish-wiki.mjs --check",
    "wiki:publish": "pnpm version:check && node scripts/publish-wiki.mjs"
  },
  "dependencies": {
    "@ricenote/plugin-sdk": "workspace:*",
    "@ricenote/shared": "workspace:*",
    "@ricenote/theme-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
