# ---------------------------------------------------------------------------
# RiceNote 环境配置示例
# 复制为 .env 后按实际环境修改。禁止把 .env 提交到版本库。
# ---------------------------------------------------------------------------

# 运行环境：development | production | test
NODE_ENV=development

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# --------------------------- HTTP 服务 ---------------------------
HOST=0.0.0.0
PORT=3000
# 公开站点地址（用于 canonical URL、主题 url() helper）
SITE_URL=http://localhost:3000

# --------------------------- 数据库 ---------------------------
# 统一连接串；若同时提供下方分字段配置，以分字段为准
DATABASE_URL=mysql://root:cc80212562@127.0.0.1:3306/ricenote
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cc80212562
DB_NAME=ricenote
DB_CONNECTION_LIMIT=10

# --------------------------- 安全 ---------------------------
# 生产环境必须替换为高熵随机值
SESSION_SECRET=change-me-in-production
SESSION_TTL_SECONDS=7200
CSRF_ENABLED=true
# 首次启动时引导创建的管理员账号
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --------------------------- 目录 ---------------------------
STORAGE_DIR=./storage
PLUGINS_DIR=./plugins/official
THEMES_DIR=./themes

# --------------------------- 站点 ---------------------------
SITE_ID=default
SITE_TITLE=RiceNote
SITE_DESCRIPTION=插件优先的轻量级博客与内容管理系统
SITE_LANGUAGE=zh-CN

# 默认激活主题（首次启动时写入 rn_site_state）
# 可用完整主题 ID（rice.minimal）或短名（minimal）
DEFAULT_THEME=rice.minimal

# 首次启动时自动启用并迁移的插件（逗号分隔，留空则全部发现到的插件默认不启用）
RICENOTE_SEED_PLUGINS=identity,authorization,posts,taxonomy,media

# 禁用数据库写入（用于只读诊断）
DB_READONLY=false
