# ---------------------------------------------------------------------------
# RiceNote 环境配置示例
# 复制为 .env 后按实际环境修改。禁止把 .env 提交到版本库。
# ---------------------------------------------------------------------------

# 运行环境：development | production | test
NODE_ENV=development

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# --------------------------- HTTP 服务 ---------------------------
HOST=0.0.0.0
PORT=3000
# 公开站点地址（用于 canonical URL、主题 url() helper）
SITE_URL=http://localhost:3000

# --------------------------- 数据库 ---------------------------
# 统一连接串；若同时提供下方分字段配置，以分字段为准
DATABASE_URL=mysql://root:cc80212562@127.0.0.1:3306/ricenote
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cc80212562
DB_NAME=ricenote
DB_CONNECTION_LIMIT=10

# --------------------------- 安全 ---------------------------
# 生产环境必须替换为高熵随机值
SESSION_SECRET=change-me-in-production
SESSION_TTL_SECONDS=7200
CSRF_ENABLED=true
# 首次启动时引导创建的管理员账号
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --------------------------- 目录 ---------------------------
STORAGE_DIR=./storage
PLUGINS_DIR=./plugins/official
THEMES_DIR=./themes

# --------------------------- 站点 ---------------------------
SITE_ID=default
SITE_TITLE=RiceNote
SITE_DESCRIPTION=插件优先的轻量级博客与内容管理系统
SITE_LANGUAGE=zh-CN

# 默认激活主题（首次启动时写入 rn_site_state）
# 可用完整主题 ID（rice.minimal）或短名（minimal）
DEFAULT_THEME=rice.minimal

# 首次启动时自动启用并迁移的插件（逗号分隔，留空则全部发现到的插件默认不启用）
# 取值是插件短名（identity）或完整 ID（rice.identity）。
# 官方插件全量清单：identity 身份 / authorization 权限 / posts 文章 / pages 页面 /
#                    taxonomy 分类标签 / media 媒体 / comments 评论 / search 搜索 / seo
RICENOTE_SEED_PLUGINS=identity,authorization,posts,pages,taxonomy,media,comments,search,seo

# 声明式插件清单：期望安装的官方插件与版本区间（`包名@区间`，逗号分隔）。
# 由 `pnpm run setup` 自动写出，用于「重建环境可复现」与启动期核对。
# 内核启动时**只核对不安装**：缺件或不满足区间会在日志里给出可执行命令。
# RICENOTE_PLUGINS=@ricenote/plugin-identity@1.3.0,@ricenote/plugin-authorization@1.3.0,@ricenote/plugin-posts@1.5.0

# 额外的本地插件根目录（开发调试用，逗号分隔）。
# 这些目录参与插件发现，因此**不需要"安装"这个动作**；开发环境还会监视其变化并自动重启内核。
# RICENOTE_LOCAL_PLUGINS=../my-plugins

# --------------------------- 插件安装 ---------------------------
# 私有 npm 源（只从环境变量读取，不落库、不进日志）
# RICENOTE_NPM_REGISTRY=https://registry.npmjs.org
# RICENOTE_NPM_TOKEN=npm_xxx
# 是否允许插件安装过程中的依赖安装脚本与构建脚本（后台会以高风险确认明示）
# RICENOTE_ALLOW_INSTALL_SCRIPTS=true
# 单条安装命令超时（秒）
# RICENOTE_INSTALL_TIMEOUT_SECONDS=600

# 禁用数据库写入（用于只读诊断）
DB_READONLY=false

# --------------------------- 日志 ---------------------------
# 终端输出格式：pretty（人可读）| json（机器可读）。
# 缺省按 TTY 自动判断：交互式终端用 pretty，被重定向/CI 用 json；
# 日志文件始终为 JSON Lines，不受该项影响。
# LOG_FORMAT=pretty

# --------------------------- 备份工具 ---------------------------
# MySQL 客户端未加入 PATH 时可写绝对路径（Windows 官方安装包默认不在 PATH 中）
# MYSQLDUMP_BIN=mysqldump
# MYSQL_BIN=mysql
