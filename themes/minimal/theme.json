{
  "schemaVersion": 1,
  "id": "rice.minimal",
  "name": "Minimal",
  "description": "极简阅读主题：留白优先、排版层级清晰、零构建。所有配色与排版参数均可在后台「外观 → 主题设置」中调整。",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "engine": "nunjucks",
  "author": "RiceNote",
  "license": "MIT",
  "templates": {
    "home": "index.njk",
    "post": "post.njk",
    "archive": "archive.njk",
    "search": "search.njk",
    "404": "404.njk"
  },
  "requires": {
    "content.posts@1": "^1.0.0"
  },
  "settings": {
    "appearance": {
      "label": "外观",
      "description": "控制站点的整体观感",
      "fields": {
        "accentColor": {
          "type": "color",
          "label": "强调色",
          "description": "用于链接、按钮与选中态",
          "default": "#89A9C7"
        },
        "layoutWidth": {
          "type": "number",
          "label": "内容宽度(px)",
          "default": 960,
          "min": 640,
          "max": 1440
        },
        "fontFamily": {
          "type": "select",
          "label": "正文字体",
          "default": "system",
          "options": [
            { "label": "系统无衬线", "value": "system" },
            { "label": "衬线（阅读感更强）", "value": "serif" },
            { "label": "等宽", "value": "mono" }
          ]
        },
        "showSidebar": {
          "type": "boolean",
          "label": "显示侧边栏",
          "description": "首页右侧展示插槽与站点信息",
          "default": true
        },
        "postsPerPage": {
          "type": "number",
          "label": "每页文章数（展示用）",
          "default": 10,
          "min": 1,
          "max": 50
        }
      }
    },
    "header": {
      "label": "页眉",
      "fields": {
        "tagline": {
          "type": "text",
          "label": "站点副标题",
          "default": "记录、思考与沉淀",
          "maxLength": 80
        },
        "showSearch": {
          "type": "boolean",
          "label": "显示搜索入口",
          "default": true
        }
      }
    },
    "footer": {
      "label": "页脚",
      "fields": {
        "footerText": {
          "type": "text",
          "label": "页脚文字",
          "default": "Powered by RiceNote",
          "maxLength": 160
        },
        "icp": {
          "type": "url",
          "label": "备案链接",
          "description": "可留空",
          "default": ""
        }
      }
    }
  }
}
