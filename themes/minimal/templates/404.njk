{% extends "layout.njk" %}

{% block title %}页面不存在 · {{ site.title }}{% endblock %}

{% block content %}
<section class="rn-empty rn-empty--404">
  <p class="rn-eyebrow">404</p>
  <h1>页面不存在</h1>
  <p class="rn-muted">{{ message or '你访问的页面不存在或已被移除。' }}</p>
  <p>
    <a class="rn-button" href="{{ url('home') }}">返回首页</a>
  </p>
</section>
{% endblock %}
