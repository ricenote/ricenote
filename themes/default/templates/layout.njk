<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}{{ page.title }} · {{ site.title }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ site.description }}{% endblock %}">
  <link rel="canonical" href="{{ page.canonicalUrl }}">
  <link rel="stylesheet" href="{{ theme_asset('css/style.css') }}">
  {{ slot('head.end') }}
</head>
<body style="--df-accent: {{ theme.settings.accentColor | css_color }};">
  {{ slot('body.start') }}

  <header class="df-hero">
    <div class="df-shell df-hero__inner">
      <a class="df-logo" href="{{ url('home') }}">
        <span class="df-logo__mark">R</span>
        <span class="df-logo__text">{{ site.title }}</span>
      </a>
      <nav class="df-nav">
        <a href="{{ url('home') }}">全部文章</a>
        {% if has_feature('search') %}<a href="{{ url('search') }}">搜索</a>{% endif %}
        {{ slot('header.navigation') }}
      </nav>
    </div>
  </header>

  <div class="df-shell df-body">
    <main class="df-main">{% block content %}{% endblock %}</main>
    {% if page.kind != 'post' %}
      <aside class="df-aside">{{ slot('sidebar.widgets') }}</aside>
    {% endif %}
  </div>

  <footer class="df-footer">
    <div class="df-shell">
      <p>{{ theme.settings.footerText }}</p>
      {{ slot('footer.widgets') }}
    </div>
  </footer>

  {{ slot('body.end') }}
  {#
    短代码：内核提供解析引擎，本主题定义具体短代码（见 assets/js/shortcodes.js）。
    引擎必须排在主题脚本之前；两者同为 defer，按文档顺序执行。
    不引入这一行也不影响别的功能：标记会原样显示为文字。
  #}
  {{ shortcode_runtime() }}
  <script src="{{ theme_asset('js/shortcodes.js') }}" defer></script>
  <script src="{{ theme_asset('js/main.js') }}" defer></script>
</body>
</html>
