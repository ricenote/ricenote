{#
  友情链接页（由 rice.friend-links 插件提供的 kind=links 页面）。
  friendLinks 是页面注入的顶层变量，元素形状：
    { name, url, avatarUrl, description }  —— 后两项可能为空串。
  插件未启用时不会有这个页面，因此这里不需要 has_feature 判断。
#}
{% extends "layout.njk" %}

{% block title %}友情链接 · {{ site.title }}{% endblock %}
{% block description %}{{ site.description }}{% endblock %}

{% block content %}
<header class="rn-archive-header">
  <p class="rn-eyebrow">友情链接</p>
  <h1>友情链接</h1>
  <p class="rn-muted">共 {{ friendLinks.length }} 个站点</p>
</header>

{% if friendLinks.length %}
  <ul class="rn-links">
    {% for link in friendLinks %}
      <li class="rn-link">
        <a class="rn-link__anchor" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
          {% if link.avatarUrl %}
            <img class="rn-link__avatar" src="{{ link.avatarUrl }}" alt="" loading="lazy">
          {% endif %}
          <span class="rn-link__body">
            <span class="rn-link__name">{{ link.name }}</span>
            {% if link.description %}<span class="rn-link__desc">{{ link.description }}</span>{% endif %}
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <section class="rn-empty">
    <p class="rn-muted">暂无友情链接。</p>
  </section>
{% endif %}
{% endblock %}
