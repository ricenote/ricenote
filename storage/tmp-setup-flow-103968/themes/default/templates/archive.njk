{% extends "layout.njk" %}

{% block title %}{{ term.name }} · {{ site.title }}{% endblock %}

{% block content %}
<h1 class="df-heading">{{ '分类' if term.type == 'category' else '标签' }}：{{ term.name }}</h1>
<p class="df-sub">共 {{ posts.total }} 篇</p>

{% if posts and posts.items.length %}
  <ul class="df-list">
    {% for post in posts.items %}
      <li>
        <a href="{{ post.url }}">{{ post.title }}</a>
        {% if post.publishedAt %}<time datetime="{{ post.publishedAt }}">{{ post.publishedAt | date('YYYY-MM-DD') }}</time>{% endif %}
      </li>
    {% endfor %}
  </ul>
  {% if pagination and pagination.totalPages > 1 %}
    <nav class="df-pager">
      {% if pagination.hasPrev %}<a href="{{ pagination.prevUrl }}">← 上一页</a>{% else %}<span class="df-pager__off">← 上一页</span>{% endif %}
      <span>{{ pagination.page }} / {{ pagination.totalPages }}</span>
      {% if pagination.hasNext %}<a href="{{ pagination.nextUrl }}">下一页 →</a>{% else %}<span class="df-pager__off">下一页 →</span>{% endif %}
    </nav>
  {% endif %}
{% else %}
  <p class="df-sub">该归档下暂无文章。</p>
{% endif %}
{% endblock %}
